<?xml version="1.0" encoding="utf-8"?>
<!--
  Jagoo Network Security Config
  - Permite tráfico HTTPS hacia Supabase y servicios externos
  - Bloquea HTTP en producción (solo HTTPS)
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Solo para debug local si se necesita HTTP -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
