<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jagoo.app">

    <!-- ── Permisos de red ──────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ── Notificaciones push (Android 13+) ──────────────────────────────── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── Leer imágenes para subir comprobantes ──────────────────────────── -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Fallback Android 12 y anteriores -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jagoo"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Google Maps API Key (valor en local.properties → manifestPlaceholders) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Splash → MainActivity -->
        <activity
            android:name="com.jagoo.app.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Jagoo.Splash"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.jagoo.app.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Jagoo"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <!-- Deep link: jagoo://order/{orderId} desde notificaciones push -->
            <intent-filter>
                <action android:name="android.intent.action_VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="jagoo" android:host="order" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging -->
        <service
            android:name="com.jagoo.app.notifications.JagooFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
