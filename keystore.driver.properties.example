# ── keystore.driver.properties — App Driver Jagoo ────────────────────────────
# Copia este archivo como keystore.driver.properties en la RAÍZ del proyecto.
# NUNCA lo subas a git (ya está en .gitignore).
#
# Para generar un keystore nuevo:
#   keytool -genkey -v -keystore jagoo-driver-release.jks \
#     -alias jagoo-driver -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=../jagoo-driver-release.jks
storePassword=TU_STORE_PASSWORD
keyAlias=jagoo-driver
keyPassword=TU_KEY_PASSWORD
