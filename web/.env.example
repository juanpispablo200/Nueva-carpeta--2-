# ── Supabase ──────────────────────────────────────────────────────────────────
# URL del proyecto (Settings → API → Project URL)
VITE_SUPABASE_URL=https://TUPROYECTO.supabase.co

# Anon key (Settings → API → Project API Keys → View legacy API keys → anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Uso ───────────────────────────────────────────────────────────────────────
# 1. Copia este archivo como .env en la misma carpeta web/
# 2. Rellena los valores reales (no comitees .env, ya está en .gitignore)
# 3. Reinicia el servidor: npm run dev
